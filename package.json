{
  "name": "vanguard-studio-pro",
  "private": true,
  "version": "1.1.0",
  "description": "Vanguard Studio Pro - a professional non-linear video editor that runs in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test:maths": "esbuild tests/engine-maths.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/engine-maths.mjs && node node_modules/.cache/engine-maths.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "immer": "^10.2.0",
    "mediabunny": "^1.55.7",
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
